use std::math
use font

pub struct Chip8 {
    pub memory: Vec<u8>, pub v: Vec<int>, pub display: Vec<u8>, pub keys: Vec<bool>,
    pub i: int, pub pc: int, pub stack: Vec<int>, pub sp: int,
    pub delay_timer: int, pub sound_timer: int, pub waiting: bool,
    key_reg: int, draw: bool,
}

pub fn new() -> Chip8 {
    let mut cpu = Chip8 {
        memory: vec![0; 4096], v: vec![0; 16], display: vec![0; 2048], keys: vec![false; 16],
        i: 0, pc: 512, stack: vec![0; 16], sp: 0,
        delay_timer: 0, sound_timer: 0, waiting: false, key_reg: 0, draw: true,
    }
    let data = font::data()
    for j in 0..data.len() { cpu.memory[j] = data[j] }
    cpu
}

impl Chip8 {
    pub fn load_rom(mut self, data: Vec<u8>) -> Result<(), string> {
        if data.is_empty() { return Err("ROM is empty") }
        if data.len() > 3584 { return Err("ROM exceeds 3584 bytes") }
        self.memory = vec![0; 4096];
        self.v = vec![0; 16];
        self.display = vec![0; 2048];
        self.keys = vec![false; 16];
        self.stack = vec![0; 16];
        self.pc = 512;
        self.i = 0;
        self.sp = 0;
        self.delay_timer = 0;
        self.sound_timer = 0;
        self.waiting = false;
        self.key_reg = 0;
        self.draw = true;
        let data_font = font::data()
        for j in 0..data_font.len() { self.memory[j] = data_font[j]; () }
        for j in 0..data.len() { self.memory[512 + j] = data[j]; () }
        Ok(())
    }

    pub fn take_draw(mut self) -> bool {
        let draw = self.draw
        self.draw = false;
        draw
    }

    pub fn tick_timers(mut self) {
        if self.delay_timer > 0 { self.delay_timer -= 1; () }
        if self.sound_timer > 0 { self.sound_timer -= 1; () }
    }

    pub fn cycle(mut self) -> Result<(), string> {
        if self.waiting {
            for k in 0..16 {
                if self.keys[k] {
                    self.v[self.key_reg] = k;
                    self.waiting = false;
                    break
                }
            }
            return Ok(())
        }
        if self.pc < 0 || self.pc > 4094 { return Err("program counter out of bounds: {self.pc}") }
        let at = self.pc
        let opcode = ((self.memory[at] as int) << 8) | (self.memory[at + 1] as int)
        self.pc += 2;
        let nib = opcode >> 12
        let x = (opcode >> 8) & 15
        let y = (opcode >> 4) & 15
        let n = opcode & 15
        let nn = opcode & 255
        let nnn = opcode & 4095
        let vx = self.v[x]
        let vy = self.v[y]
        match nib {
            0 => {
                if opcode == 0x00E0 {
                    for j in 0..2048 { self.display[j] = 0; () }
                    self.draw = true;
                    ()
                } else if opcode == 0x00EE {
                    if self.sp <= 0 { return Err("stack underflow at {at}") }
                    self.sp -= 1;
                    self.pc = self.stack[self.sp];
                    ()
                }
            },
            1 => { self.pc = nnn; () },
            2 => {
                if self.sp >= 16 { return Err("stack overflow at {at}") }
                self.stack[self.sp] = self.pc;
                self.sp += 1;
                self.pc = nnn;
                ()
            },
            3 => { if vx == nn { self.pc += 2; () } },
            4 => { if vx != nn { self.pc += 2; () } },
            5 => {
                if n != 0 { return Err("invalid opcode {opcode} at {at}") }
                if vx == vy { self.pc += 2; () }
            },
            6 => { self.v[x] = nn; () },
            7 => { self.v[x] = (vx + nn) & 255; () },
            8 => {
                match n {
                    0 => { self.v[x] = vy; () },
                    1 => { self.v[x] = vx | vy; () },
                    2 => { self.v[x] = vx & vy; () },
                    3 => { self.v[x] = vx ^ vy; () },
                    4 => {
                        self.v[x] = (vx + vy) & 255;
                        self.v[15] = if vx + vy > 255 { 1 } else { 0 };
                        ()
                    },
                    5 => {
                        self.v[x] = (vx - vy) & 255;
                        self.v[15] = if vx >= vy { 1 } else { 0 };
                        ()
                    },
                    6 => {
                        self.v[x] = vx >> 1;
                        self.v[15] = vx & 1;
                        ()
                    },
                    7 => {
                        self.v[x] = (vy - vx) & 255;
                        self.v[15] = if vy >= vx { 1 } else { 0 };
                        ()
                    },
                    14 => {
                        self.v[x] = (vx << 1) & 255;
                        self.v[15] = vx >> 7;
                        ()
                    },
                    _ => { return Err("invalid opcode {opcode} at {at}") },
                }
            },
            9 => {
                if n != 0 { return Err("invalid opcode {opcode} at {at}") }
                if vx != vy { self.pc += 2; () }
            },
            10 => { self.i = nnn; () },
            11 => { self.pc = nnn + self.v[0]; () },
            12 => { self.v[x] = math::randint(0, 255) & nn; () },
            13 => {
                if self.i < 0 || self.i + n > 4096 { return Err("sprite outside memory at {at}") }
                let sx = vx % 64
                let sy = vy % 32
                self.v[15] = 0;
                for row in 0..n {
                    if sy + row >= 32 { break }
                    let sprite = self.memory[self.i + row] as int
                    for col in 0..8 {
                        if sx + col >= 64 { break }
                        if (sprite & (128 >> col)) != 0 {
                            let index = (sy + row) * 64 + sx + col
                            if self.display[index] == 1 { self.v[15] = 1; () }
                            self.display[index] = self.display[index] ^ 1;
                            ()
                        }
                    }
                }
                self.draw = true;
                ()
            },
            14 => {
                if nn == 0x9E {
                    if self.keys[vx & 15] { self.pc += 2; () }
                } else if nn == 0xA1 {
                    if !self.keys[vx & 15] { self.pc += 2; () }
                } else { return Err("invalid opcode {opcode} at {at}") }
            },
            15 => {
                match nn {
                    7 => { self.v[x] = self.delay_timer; () },
                    10 => { self.waiting = true; self.key_reg = x; () },
                    21 => { self.delay_timer = vx; () },
                    24 => { self.sound_timer = vx; () },
                    30 => { self.i = (self.i + vx) & 4095; () },
                    41 => { self.i = (vx & 15) * 5; () },
                    51 => {
                        if self.i < 0 || self.i + 3 > 4096 { return Err("BCD outside memory at {at}") }
                        self.memory[self.i] = (vx / 100) as u8;
                        self.memory[self.i + 1] = ((vx / 10) % 10) as u8;
                        self.memory[self.i + 2] = (vx % 10) as u8;
                        ()
                    },
                    85 => {
                        if self.i < 0 || self.i + x >= 4096 { return Err("register store outside memory at {at}") }
                        for j in 0..=x { self.memory[self.i + j] = self.v[j] as u8; () }
                    },
                    101 => {
                        if self.i < 0 || self.i + x >= 4096 { return Err("register load outside memory at {at}") }
                        for j in 0..=x { self.v[j] = self.memory[self.i + j] as int; () }
                    },
                    _ => { return Err("invalid opcode {opcode} at {at}") },
                }
            },
            _ => { return Err("invalid opcode {opcode} at {at}") },
        }
        Ok(())
    }
}
